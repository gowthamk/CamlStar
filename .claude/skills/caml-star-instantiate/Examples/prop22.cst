module Prop22

type nat =
  | Z : nat
  | S : nat -> nat

let rec max x y = match x with
  | Z -> y
  | S x' -> (match y with
             | Z -> x
             | S y' -> S (max x' y'))

val tip_22 : a:nat -> b:nat -> c:nat -> Lemma(ensures max (max a b) c = max a (max b c))
let rec tip_22 a b c = match a with
  | Z -> ()
  | S a' -> (match b with
             | Z -> ()
             | S b' -> (match c with
                        | Z -> let _ = instantiate!(S (max a' b')) in ()
                        | S c' -> tip_22 a' b' c'))
