module HofRejectLemma

(* Rejection test: a lemma quantified over a function. Its statement ranges over every
   `f`, which is outside the fragment in v1 (plan step H10 would specialize it per
   use). Expected: a specialization error naming the lemma and the parameter, and no
   VC (the lemma is not silently dropped with the templates). The supported way to
   state it is tests/hof_uninterp.cst's: an `assume val` symbol in place of the
   quantified function. Run by tests/reject_hof.sh, which checks the line below.
EXPECT: map_len_any: a lemma over a function (parameter f) is outside the fragment; state it at a concrete function, or at an `assume val` symbol
*)

type nat =
  | Z : nat
  | S : nat -> nat

type nlist =
  | NNil : nlist
  | NCons : nat -> nlist -> nlist

let rec len (l:nlist) = match l with
  | NNil -> Z
  | NCons x r -> S (len r)

let rec map (f:nat -> nat) (l:nlist) = match l with
  | NNil -> NNil
  | NCons x r -> NCons (f x) (map f r)

val map_len_any : f:(nat -> nat) -> xs:nlist -> Lemma(ensures len (map f xs) = len xs)
let rec map_len_any f xs = match xs with
  | NNil -> ()
  | NCons x r -> map_len_any f r
