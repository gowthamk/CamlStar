module HofSpec

(* Regression test for a refined template: `find_or`'s `val` mentions its function
   parameter in the result refinement (`f r`). Each clone must get its own `val`, the
   template's type with `f` replaced by the lambda (beta-reduced) and the captured
   variables as leading parameters, so the checker checks the clone against its own
   instance of the spec and a caller can use it. The callers here bind the call
   (`let r = … in`), which uses the spec through ordinary typing. Every arm of
   `find_or` returns a variable, not a nullary constructor (a refined arm returning a
   nullary constructor needs refined-rec-defs, not on this branch). Today the checker
   stops at the first lambda passed to the refined template (`check error: cannot
   synthesize a function; annotation required`). The false goals are tests/hof_bad.cst. *)

type nat =
  | Z : nat
  | S : nat -> nat

type nlist =
  | NNil : nlist
  | NCons : nat -> nlist -> nlist

let rec le (x:nat) (y:nat) = match x with
  | Z -> true
  | S a -> (match y with
            | Z -> false
            | S b -> le a b)

val find_or : f:(nat -> bool) -> d:nat -> l:nlist -> r:nat{f r \/ r = d}
let rec find_or f d l = match l with
  | NNil -> d
  | NCons x rest -> if f x then x else find_or f d rest

(* a captured variable *)
val find_ge : v:nat -> l:nlist ->
  Lemma(ensures le v (find_or (fun x -> le v x) Z l) = true \/ find_or (fun x -> le v x) Z l = Z)
let find_ge v l = let r = find_or (fun x -> le v x) Z l in ()

(* the spec makes the result determined *)
val find_eq : v:nat -> l:nlist -> Lemma(ensures find_or (fun x -> x = v) v l = v)
let find_eq v l = let r = find_or (fun x -> x = v) v l in ()
