module Prop65

type nat =
  | Z : nat
  | S : nat -> nat

let rec add x y = match x with
  | Z -> y
  | S x' -> S (add x' y)

let rec lt x y = match y with
  | Z -> false
  | S y' -> (match x with
             | Z -> true
             | S x' -> lt x' y')

val add_succ_r : x:nat -> y:nat -> Lemma(ensures add x (S y) = S (add x y))
let rec add_succ_r x y = match x with
  | Z -> ()
  | S x' -> add_succ_r x' y

val tip_65 : i:nat -> m:nat -> Lemma(ensures lt i (S (add m i)))
let rec tip_65 i m = match i with
  | Z -> ()
  | S i' -> let u1 = add_succ_r m i' in tip_65 i' m
