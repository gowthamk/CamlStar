module Prop21

type nat =
  | Z : nat
  | S : nat -> nat

let rec add x y = match x with
  | Z -> y
  | S x' -> S (add x' y)

let rec le x y = match x with
  | Z -> true
  | S x' -> (match y with
             | Z -> false
             | S y' -> le x' y')

val tip_21 : n:nat -> m:nat -> Lemma(ensures le n (add n m))
let rec tip_21 n m = match n with
  | Z -> ()
  | S n' -> tip_21 n' m
