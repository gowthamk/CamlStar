module UnitParam

(* Regression test for F*'s unit parameter: `val l : unit -> Lemma(…)` with
   `let l () = …`, called as `l ()`. Before the fix the `()` binder was a parse error.
   The false goals over the same definitions are tests/unit_param_bad.cst. *)

type nat =
  | Z : nat
  | S : nat -> nat

let rec add (x:nat) (y:nat) = match x with
  | Z -> y
  | S a -> S (add a y)

(* a closed fact stated with a unit parameter *)
val add_two_z : unit -> Lemma(ensures add (S (S Z)) Z = S (S Z))
let add_two_z () = ()

(* a unit-parameter lemma proved by calling another *)
val add_two_z_again : unit -> Lemma(ensures add (S (S Z)) Z = S (S Z))
let add_two_z_again () = add_two_z ()

(* a unit-parameter lemma called from an ordinary one, inside a match arm *)
val add_x_two_z : x:nat -> Lemma(ensures add x Z = x ==> add (S x) Z = S x)
let add_x_two_z x = match x with
  | Z -> add_two_z ()
  | S a -> let _ = add_two_z () in ()

(* a unit parameter among other parameters *)
val add_z : u:unit -> x:nat -> Lemma(ensures add Z x = x)
let add_z () x = ()
