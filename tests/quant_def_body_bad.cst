module QuantDefBodyBad

(* Error test for tests/quant_def.cst: a quantified definition applied inside a function
   body. Expected: the run stops with
     error: pick uses a quantified formula in its body; a quantified predicate must
     return bool and be a plain formula (no match, let or if around the quantifier),
     and it is unfolded only in specs and proofs, not in a function body
   and no VC is solved. Not run by strip_and_reprove.sh. *)

type nat =
  | Z : nat
  | S : nat -> nat

type nlist =
  | NNil : nlist
  | NCons : nat -> nlist -> nlist

let rec mem (x:nat) (l:nlist) = match l with
  | NNil -> false
  | NCons y r -> if x = y then true else mem x r

let all_z (l:nlist) = forall (y:nat). mem y l ==> y = Z

(* a data-returning function deciding on the predicate: not allowed *)
let pick (l:nlist) = if all_z l then Z else S Z

val pick_nil : u:nat -> Lemma(ensures pick NNil = Z)
let pick_nil u = ()
