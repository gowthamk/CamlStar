module Prop70

type nat =
  | Z : nat
  | S : nat -> nat

let rec le x y = match x with
  | Z -> true
  | S x' -> (match y with
             | Z -> false
             | S y' -> le x' y')

val tip_70 : m:nat -> n:nat -> Lemma(ensures le m n ==> le m (S n))
let rec tip_70 m n = match m with
  | Z -> ()
  | S m' -> (match n with
             | Z -> ()
             | S n' -> tip_70 m' n')
