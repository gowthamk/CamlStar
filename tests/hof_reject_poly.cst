module HofRejectPoly

(* Rejection test: a polymorphic template. Without polymorphism in the encoding a
   template over `'a` has no sort to specialize at, so v1 rejects it. Expected after
   specialization: a check error naming the template and the type variable, e.g.
     map: a polymorphic template (type variable 'a) cannot be specialized; write a
     monomorphic copy
   and no VC. Today: `Fatal error: exception Failure("axioms: higher-order
   field/return not supported")`. *)

type nat =
  | Z : nat
  | S : nat -> nat

type list 'a =
  | Nil : list 'a
  | Cons : 'a -> list 'a -> list 'a

let rec map (f:'a -> 'a) (l:list 'a) = match l with
  | Nil -> Nil
  | Cons x r -> Cons (f x) (map f r)

val map_nil : u:nat -> Lemma(ensures map (fun x -> S x) Nil = Nil)
let map_nil u = ()
