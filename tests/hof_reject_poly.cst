module HofRejectPoly

(* Rejection test: a polymorphic template. Without polymorphism in the encoding a
   template over `'a` has no sort to specialize at, so v1 rejects it. Expected: a
   specialization error naming the template and the type variable, and no VC. Run by
   tests/reject_hof.sh, which checks the line below.
EXPECT: map: a polymorphic template (type variable 'a) cannot be specialized; write a monomorphic copy
*)

type nat =
  | Z : nat
  | S : nat -> nat

type list 'a =
  | Nil : list 'a
  | Cons : 'a -> list 'a -> list 'a

let rec map (f:'a -> 'a) (l:list 'a) = match l with
  | Nil -> Nil
  | Cons x r -> Cons (f x) (map f r)

val map_nil : u:nat -> Lemma(ensures map (fun x -> S x) Nil = Nil)
let map_nil u = ()
